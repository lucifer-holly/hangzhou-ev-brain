{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hz-ev-brain.local/contracts/operators/starcharge.schema.json",
  "title": "StarCharge Pile Schema",
  "description": "StarCharge (星星充电) pile telemetry payload (mock). Pure software-house style: snake_case, deep nested objects (geo / metrics / network / operator_metadata), generous use of UUIDs.",
  "type": "object",
  "required": ["pile_id", "operator_id", "geo", "metrics"],
  "additionalProperties": false,
  "properties": {
    "pile_id": {
      "type": "string",
      "format": "uuid"
    },
    "operator_id": {
      "type": "string",
      "format": "uuid"
    },
    "energy_supplier": {
      "type": "string",
      "description": "Upstream electricity vendor, e.g. \"state_grid_zhejiang\"."
    },
    "geo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lng"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "altitude": { "type": "number" },
        "geohash": { "type": "string" },
        "address_zh": { "type": "string" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instant_power_kw"],
      "properties": {
        "instant_power_kw": { "type": "number" },
        "session_energy_kwh": { "type": "number", "minimum": 0 },
        "lifetime_energy_kwh": { "type": "number", "minimum": 0 },
        "soc_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "estimated_remaining_minutes": { "type": ["integer", "null"], "minimum": 0 },
        "session_count_today": { "type": "integer", "minimum": 0 }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rssi_dbm": { "type": "number" },
        "uplink_kbps": { "type": "number" },
        "last_packet_loss_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "carrier": { "enum": ["china_mobile", "china_unicom", "china_telecom"] }
      }
    },
    "operator_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tags": { "type": "array", "items": { "type": "string" } },
        "tariff_plan": { "type": "string" },
        "owner_business_unit": { "type": "string" }
      }
    },
    "reported_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
