{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hz-ev-brain.local/contracts/operators/state-grid.schema.json",
  "title": "State Grid Charging Pile Schema",
  "description": "国家电网（State Grid Corporation of China）公开充电桩接口数据格式 (mock). 风格保留传统国企/行业 API 特征：snake_case、字段冗长且包含监管语境（区域电网编码、制造商备案号、电价目录版本号等）。",
  "type": "object",
  "required": [
    "device_no",
    "station_code",
    "region_grid_code",
    "manufacturer_code",
    "rated_power_kw",
    "real_time_status"
  ],
  "additionalProperties": false,
  "properties": {
    "device_no": {
      "type": "string",
      "pattern": "^SG-[0-9]{8}$",
      "description": "国网内部设备编号，固定 SG- 前缀 + 8 位数字。"
    },
    "station_code": {
      "type": "string",
      "pattern": "^[0-9]{6}-[0-9]{4}$",
      "description": "充电站编号（行政区划 6 位 + 站序号 4 位）。"
    },
    "station_name_zh": {
      "type": "string",
      "description": "中文站名，供运维台账打印用。"
    },
    "region_grid_code": {
      "type": "string",
      "pattern": "^E[0-9]{4}$",
      "description": "国网区域电网编码（华东 / 华北 / 华中 …）。"
    },
    "operator_company_code": {
      "type": "string",
      "description": "省级公司统一信用代码后 9 位。"
    },
    "manufacturer_code": {
      "type": "string",
      "description": "充电桩硬件厂商在国网备案的 4 位代码。"
    },
    "manufacturer_serial_no": {
      "type": "string"
    },
    "rated_power_kw": {
      "type": "number",
      "minimum": 0,
      "description": "出厂额定功率（千瓦）。"
    },
    "rated_voltage_v": {
      "type": "number",
      "minimum": 0
    },
    "rated_amperage_a": {
      "type": "number",
      "minimum": 0
    },
    "connector_count": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "tariff_book_version": {
      "type": "string",
      "description": "现行电价目录版本号，遇政府调价随之更新。"
    },
    "installation_date_yyyy_mm_dd": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "last_inspection_date_yyyy_mm_dd": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "上次现场巡检日期（监管要求每季度一次）。"
    },
    "real_time_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_voltage_v", "current_amperage_a", "occupancy_status"],
      "properties": {
        "current_voltage_v": { "type": "number" },
        "current_amperage_a": { "type": "number" },
        "current_active_power_kw": { "type": "number" },
        "current_temperature_celsius": { "type": "number" },
        "occupancy_status": {
          "enum": ["idle", "charging", "fault", "offline", "out_of_service"]
        },
        "fault_code": {
          "type": ["string", "null"],
          "description": "国网统一故障代码表，例如 F-OV-001（过压）。"
        },
        "fault_description_zh": {
          "type": ["string", "null"]
        },
        "report_timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "subsidy_record_no": {
      "type": ["string", "null"],
      "description": "财政部 / 地方发改委备案的补贴申报号。"
    }
  }
}
