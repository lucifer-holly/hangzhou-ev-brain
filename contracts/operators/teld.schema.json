{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hz-ev-brain.local/contracts/operators/teld.schema.json",
  "title": "TELD Charging Pile Schema",
  "description": "TELD (特来电) charging-pile API payload (mock). Style mirrors a modern internet-company API: camelCase, flat where it can be, REST-friendly enums, no Chinese-only fields.",
  "type": "object",
  "required": ["stationId", "connectorId", "status"],
  "additionalProperties": false,
  "properties": {
    "stationId": {
      "type": "string",
      "format": "uuid"
    },
    "connectorId": {
      "type": "string",
      "description": "Per-station connector key, e.g. \"A-01\"."
    },
    "connectorType": {
      "enum": ["DC_GBT", "AC_GBT", "CCS2", "Tesla", "CHAdeMO"]
    },
    "ratedPowerKW": {
      "type": "number",
      "minimum": 0
    },
    "firmwareVersion": {
      "type": "string"
    },
    "lastHeartbeatAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "voltage", "current", "power"],
      "properties": {
        "voltage": { "type": "number" },
        "current": { "type": "number" },
        "power": { "type": "number" },
        "energyDeliveredKWh": { "type": "number", "minimum": 0 },
        "state": { "enum": ["AVAILABLE", "OCCUPIED", "FAULT", "MAINTENANCE", "OFFLINE"] },
        "faultCode": { "type": ["string", "null"] }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "electricityFeePerKwh": { "type": "number", "minimum": 0 },
        "serviceFeePerKwh": { "type": "number", "minimum": 0 },
        "peakHourMultiplier": { "type": "number", "minimum": 1 },
        "currency": { "enum": ["CNY", "USD"], "default": "CNY" }
      }
    },
    "session": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "Active charging session, null when idle.",
      "properties": {
        "sessionId": { "type": "string", "format": "uuid" },
        "startedAt": { "type": "string", "format": "date-time" },
        "userMaskedMobile": {
          "type": "string",
          "pattern": "^1[3-9][0-9]\\*{4}[0-9]{4}$"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Operational tags such as \"vip\", \"highway\", \"indoor\"."
    }
  }
}
