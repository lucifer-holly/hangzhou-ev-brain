# HZ-EV Brain — backend environment template.
# Copy this file to .env (it is git-ignored) and override per-machine values.
#
# All settings are also valid plain process environment variables and take
# precedence over the .env file.

# ---- Database ----
# Async URL used by FastAPI route handlers.
DATABASE_URL=sqlite+aiosqlite:///./data/hzev.db
# Sync URL used by the seed script + bulk inserts.
SYNC_DATABASE_URL=sqlite:///./data/hzev.db

# ---- MQTT ----
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=hzev/

# ---- Synth generator ----
PILE_COUNT=100
HISTORY_DAYS=30
REALTIME_TICK_SECONDS=1.0
RNG_SEED=42

# ---- Frontend (used by Spawn 3) ----
# Pin the AMap key in your real .env, never commit it.
VITE_AMAP_KEY=your-amap-key-here
