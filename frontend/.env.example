# HZ-EV Brain Frontend — environment template.
# Copy to .env to override per machine. Vite only exposes vars prefixed VITE_.

# Backend REST API base URL (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000

# Backend WebSocket URL.
VITE_WS_URL=ws://localhost:8000/ws

# Map provider: 'amap' (high quality, requires key) or 'osm' (free fallback).
VITE_MAP_PROVIDER=osm

# AMap (高德 JS API 2.0) key — required only when VITE_MAP_PROVIDER=amap.
# Get one at https://lbs.amap.com/. Never commit a real key.
VITE_AMAP_KEY=

# AMap security key (安全密钥) — required for keys issued after 2021.
# AMap docs recommend server-side proxying for production; for demo we
# inline it in the bundle. Both keys live in the repo-root .env (gitignored).
VITE_AMAP_SECURITY_KEY=

# GitHub repository URL — surfaced as a button in every console topbar.
VITE_GITHUB_URL=https://github.com/lucifer-holly/hangzhou-ev-brain
